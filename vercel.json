{
  "functions": {
    "src/app/dashboard/**": {
      "maxDuration": 10,
      "memory": 1024
    },
    "src/app/api/**": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/attendance",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/dashboard/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
